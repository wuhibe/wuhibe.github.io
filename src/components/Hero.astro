---
import Image from "astro/components/Image.astro";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  name: string;
  headline: string;
  subline: string;
  photo?: string;
  upworkUrl: string;
  email: string;
  resumeUrl?: string;
  githubUrl: string;
}

const {
  name,
  headline,
  subline,
  photo,
  upworkUrl,
  email,
  resumeUrl,
  githubUrl,
} = Astro.props;
---

<header class="hero">
  <nav class="topbar container-wide" aria-label="Primary">
    <a href="/" class="brand" aria-label="Home">
      <span class="brand-mark">W</span>
      <span class="brand-name">wuhibe</span>
    </a>
    <div class="nav-actions">
      <a
        href={githubUrl}
        class="icon-link"
        aria-label="GitHub"
        target="_blank"
        rel="noopener"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M12 .5a11.5 11.5 0 0 0-3.64 22.42c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.36-3.88-1.36-.53-1.34-1.3-1.7-1.3-1.7-1.06-.72.08-.7.08-.7 1.17.08 1.79 1.2 1.79 1.2 1.04 1.78 2.73 1.27 3.4.97.1-.75.41-1.27.74-1.56-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.51-1.47.11-3.06 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.79 0c2.21-1.49 3.18-1.18 3.18-1.18.62 1.59.23 2.77.11 3.06.74.81 1.19 1.84 1.19 3.1 0 4.43-2.7 5.4-5.27 5.69.42.36.8 1.07.8 2.16v3.2c0 .31.21.67.8.55A11.5 11.5 0 0 0 12 .5Z"
          ></path>
        </svg>
      </a>
      <ThemeToggle />
    </div>
  </nav>

  <div class="container hero-inner">
    {
      photo ? (
        <Image
          src={photo}
          alt={`Portrait of ${name}`}
          class="avatar"
          width="120"
          height="120"
          loading="eager"
        />
      ) : (
        <div class="avatar avatar-fallback" aria-hidden="true">
          WT
        </div>
      )
    }

    <h1 class="name">{name}</h1>
    <p class="headline">{headline}</p>
    <p class="subline">{subline}</p>

    <ul class="stats" aria-label="Professional highlights">
      <li>
        <span class="stat-num">3,600+</span><span class="stat-label"
          >hours shipped</span
        >
      </li>
      <li>
        <span class="stat-num">100%</span><span class="stat-label"
          >job success</span
        >
      </li>
      <li>
        <span class="stat-num">Top 3%</span><span class="stat-label"
          >on Upwork</span
        >
      </li>
      <li>
        <span class="stat-num">Top Rated Plus</span><span class="stat-label"
          >since 2024</span
        >
      </li>
    </ul>

    <div class="cta-row">
      <a
        href={upworkUrl}
        class="btn btn-primary"
        target="_blank"
        rel="noopener"
      >
        Hire me on Upwork
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14M13 5l7 7-7 7"></path>
        </svg>
      </a>
      <a href={`mailto:${email}`} class="btn btn-ghost">Email me</a>
    </div>

    {
      resumeUrl && (
        <a
          href={resumeUrl}
          class="resume-link"
          target="_blank"
          rel="noopener"
          download
        >
          ↓ download resume (PDF)
        </a>
      )
    }
  </div>
</header>

<style>
  .hero {
    position: relative;
    padding-bottom: 24px;
  }

  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 20px;
    padding-bottom: 20px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    border-bottom: none;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 14px;
  }

  .brand:hover {
    color: var(--accent);
  }

  .brand-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--accent);
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 0.05em;
  }

  .brand-name {
    color: var(--muted);
  }

  .nav-actions {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    color: var(--text);
    transition:
      border-color var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .icon-link:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .icon-link svg {
    width: 18px;
    height: 18px;
  }

  .hero-inner {
    padding-top: 56px;
    padding-bottom: 16px;
  }

  @media (min-width: 768px) {
    .hero-inner {
      padding-top: 88px;
    }
  }

  .avatar {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    object-fit: cover;
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 14%, transparent);
    margin-bottom: 28px;
  }

  .avatar-fallback {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 28px;
    color: var(--accent);
  }

  .name {
    font-size: clamp(34px, 6vw, 56px);
    margin-bottom: 14px;
  }

  .headline {
    font-size: clamp(20px, 2.6vw, 26px);
    color: var(--text);
    max-width: 36ch;
    margin-bottom: 10px;
    line-height: 1.3;
  }

  .subline {
    color: var(--muted);
    max-width: 56ch;
    font-size: 15px;
  }

  .stats {
    list-style: none;
    padding: 0;
    margin: 32px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
  }

  .stats li {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-right: 24px;
    border-right: 1px solid var(--border);
  }

  .stats li:last-child {
    border-right: none;
    padding-right: 0;
  }

  .stat-num {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--accent);
    font-weight: 600;
  }

  .stat-label {
    font-size: 12px;
    color: var(--muted);
    text-transform: lowercase;
    letter-spacing: 0.03em;
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 18px;
    border-radius: var(--radius-md);
    font-size: 14px;
    font-weight: 500;
    border: 1px solid var(--border);
    transition:
      transform var(--dur) var(--ease),
      border-color var(--dur) var(--ease),
      background var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .btn svg {
    width: 16px;
    height: 16px;
    transition: transform var(--dur) var(--ease);
  }

  .btn:hover svg {
    transform: translateX(2px);
  }

  .btn-primary {
    background: var(--accent);
    color: #0a0a0b;
    border-color: var(--accent);
  }

  :root[data-theme="light"] .btn-primary {
    color: #ffffff;
  }

  .btn-primary:hover {
    background: var(--accent-dim);
    border-color: var(--accent-dim);
    color: #0a0a0b;
  }

  :root[data-theme="light"] .btn-primary:hover {
    color: #ffffff;
  }

  .btn-ghost {
    background: transparent;
    color: var(--text);
  }

  .btn-ghost:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .resume-link {
    display: inline-block;
    margin-top: 18px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--muted);
    border-bottom: none;
  }

  .resume-link:hover {
    color: var(--accent);
  }
</style>
